{
  "databasePath": "../workspace/shared/karena-full.db",
  "workspaceRoot": "../workspace",
  "appName": "kArenaWeb",
  "queryTimeoutMs": 10000,
  "paperUrl": "https://arxiv.org/abs/2602.02690",
  "githubUrl": "https://github.com/ARiSE-Lab/live-kbench",
  "baseUrl": "http://127.0.0.1:3000",
  "allowedCorsOrigins": [
    "http://127.0.0.1:3000",
    "http://localhost:3000"
  ],
  "allowedDevOrigins": [
    "127.0.0.1"
  ],
  "defaultResearchQuery": {
    "datasetId": 3,
    "filters": [
      {
        "field": "agentConfigName",
        "op": "in",
        "values": [
          "mini-swe-agent-c-unlimited"
        ]
      }
    ],
    "groups": [
      {
        "field": "fixedTime",
        "mode": "range",
        "ranges": [
          {
            "label": "before",
            "min": "",
            "max": "2025-02-01"
          },
          {
            "label": " after",
            "min": "2025-02-01",
            "max": ""
          }
        ]
      }
    ],
    "metrics": [
      {
        "id": "crr",
        "aggregation": "pass",
        "k": "3"
      },
      {
        "id": "epr",
        "aggregation": "pass",
        "k": "3",
        "judgeName": "gemini-3-flash-v1"
      }
    ]
  }
}
